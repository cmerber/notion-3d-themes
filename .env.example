# Copy to .env.local, or configure in Vercel. No secrets are included.
# Empty NOTION_PAGE_ID => local demo; no account or API key needed.
NOTION_PAGE_ID=
NEXT_PUBLIC_SITE_TITLE=我的小岛
NEXT_PUBLIC_AUTHOR=小岛主人
NEXT_PUBLIC_BIO=记录灵感，分享生活。
NEXT_PUBLIC_ABOUT=我在这里记录学习、创作和日常。
NEXT_PUBLIC_FOOTER=我的小岛 · 用心搭建
NEXT_PUBLIC_AVATAR=/orange/avatar-reference.webp
NEXT_PUBLIC_LINK=http://localhost:3000
NEXT_PUBLIC_THEME=orange
NEXT_PUBLIC_LANG=zh-CN
NEXT_PUBLIC_APPEARANCE=light
NEXT_PUBLIC_THEME_SWITCH=true

# Optional Notion comments. Credentials stay on the server.
NEXT_PUBLIC_COMMENT_NOTION_ENABLE=false
NOTION_TOKEN=
NOTION_COMMENT_DATABASE_ID=
NOTION_COMMENT_REQUIRE_APPROVAL=true
NOTION_COMMENT_RATE_LIMIT=5
# Optional growth profile. Empty => marked sample profile.
NOTION_PROFILE_TOKEN=
NOTION_PROFILE_DATABASE_ID=
# Optional authenticated refresh: generate your own separate random tokens.
REVALIDATION_TOKEN=
CACHE_REVALIDATION_TOKEN=
# Optional analytics: use your own IDs, never the demo site's account.
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_ANALYTICS_GOOGLE_ID=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_CONTACT_GITHUB=
NEXT_PUBLIC_CONTACT_EMAIL=
